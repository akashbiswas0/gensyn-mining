# Copy to .env and fill in yourself. Never commit .env.
# Variable names match the official starter agent (vendor/evidence-starter/README.md).

# --- Delphi competition (official values: vendor/delphi-skills/reference/competition.md) ---
# A MAINNET Delphi API key from https://api-access.delphi.fyi/ (keep "Mainnet" selected),
# created with your registered wallet. Testnet keys get 401 from the competition.
DELPHI_API_ACCESS_KEY=
# The wallet the key was created with = your DoraHacks registration wallet (needed for feedback)
DELPHI_WALLET_ADDRESS=
# Defaults (change only if the organisers announce new ones)
# DELPHI_EVIDENCE_URL=https://delphi.fyi/v1
# COMPETITION_SITE_URL=https://competition.delphi.fyi
# DELPHI_FEEDBACK_URL=https://feedback.delphi.fyi
# Accept the evidence terms only after reading them: set to the exact version that
# `npm run status` prints. The agent never accepts terms on its own.
ACCEPT_TERMS=

# --- Agent identity (sent as X-Agent-Id / X-Agent-Harness / X-Agent-Model) -------
# Must be the agent name you registered on DoraHacks (live runs refuse the placeholder)
DELPHI_AGENT_ID=
DELPHI_AGENT_HARNESS=delphi-evidence-agent-ts
# DELPHI_AGENT_MODEL defaults to RESEARCH_MODEL
# REVIEW=1   # ask before every submission (same as --review)

# --- Claude ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-opus-5-5
VERIFY_MODEL=claude-opus-5-5
RESEARCH_EFFORT=high
VERIFY_EFFORT=high

# --- Budget & pacing (rules live in config/rules.json) ---------------------------
DAILY_BUDGET_USD=10
MARKETS_PER_CYCLE=3
MAX_SUBMISSIONS_PER_CYCLE=3
LOOP_INTERVAL_MINUTES=45

# --- Testing on real Delphi markets (npm run sim) -------------------------------
# Competition markets are Delphi MAINNET markets, read with DELPHI_API_ACCESS_KEY.
# To test on another network, give its key here (testnet: https://delphi-api-access.gensyn.ai/).
DELPHI_MARKETS_NETWORK=mainnet
DELPHI_MARKETS_API_KEY=

# --- Simulator (only with --sim) ---------------------------------------------------
# SIM_JUDGE=llm            # llm (Claude forecaster) | heuristic ($0)
# SIM_JUDGE_MODEL=claude-opus-5-5
# SIM_CHAOS=0              # 0..1 probability of injected failures
# SIM_HOURLY_LIMIT=10
# SIM_GUARD=1              # also apply the acceptance guard in the simulator
# SIM_DAILY_CAP=30
# SIM_POT_USDC=20         # official: 20 judgment + 30 settlement per market
# SIM_USDC_PER_POINT=0.25  # simulated reward per percentage point the forecaster moves
# SIM_MIN_DELTA=0.02       # moves smaller than this pay 0 (below_minimum)
