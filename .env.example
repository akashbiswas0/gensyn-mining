# Copy to .env and fill in yourself. Never commit .env.
# Variable names match the official starter agent (vendor/evidence-starter/README.md).

# --- Delphi (keys and URLs published 23 Nov) -----------------------------------
COMPETITION_SITE_URL=https://agent-competition.gensyn.ai
# Evidence API base URL, including /v1
DELPHI_API_URL=
DELPHI_API_ACCESS_KEY=
# Accept the evidence terms only after reading them: set to the exact version that
# `npm run status` prints. The agent never accepts terms on its own.
ACCEPT_TERMS=

# --- Agent identity (sent as X-Agent-Id / X-Agent-Harness / X-Agent-Model) ------
# Must be the agent name you registered on DoraHacks (live runs refuse the placeholder)
AGENT_ID=
AGENT_HARNESS=delphi-evidence-agent-ts
# AGENT_MODEL defaults to RESEARCH_MODEL
# REVIEW=1   # ask before every submission (same as --review)

# --- Claude ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-opus-5-5
VERIFY_MODEL=claude-opus-5-5
RESEARCH_EFFORT=high
VERIFY_EFFORT=high

# --- Budget & pacing (rules live in config/rules.json) ---------------------------
DAILY_BUDGET_USD=10
MARKETS_PER_CYCLE=3
MAX_SUBMISSIONS_PER_CYCLE=3
LOOP_INTERVAL_MINUTES=45

# --- Testing on real Delphi markets before 23 Nov (npm run sim) ------------------
# A Delphi API key for the network you read markets from.
# mainnet key: https://api-access.delphi.fyi/   testnet key: https://delphi-api-access.gensyn.ai/
DELPHI_MARKETS_NETWORK=mainnet
DELPHI_MARKETS_API_KEY=

# --- Simulator (only with --sim) ---------------------------------------------------
# SIM_JUDGE=llm            # llm (Claude forecaster) | heuristic ($0)
# SIM_JUDGE_MODEL=claude-opus-5-5
# SIM_CHAOS=0              # 0..1 probability of injected failures
# SIM_HOURLY_LIMIT=10
# SIM_DAILY_CAP=30
# SIM_POT_USDC=250
# SIM_USDC_PER_POINT=0.5   # simulated reward per percentage point the forecaster moves
# SIM_MIN_DELTA=0.02       # moves smaller than this pay 0 (below_minimum)
